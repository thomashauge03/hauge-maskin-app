{
  "name": "hauge-maskin-app",
  "version": "2.10.0",
  "description": "Hauge Maskin – samlet skrivebordsapp for alle nettsider og verktøy",
  "main": "src/main.js",
  "author": "Hauge Maskin",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "predist": "npm test",
    "dist": "electron-builder --win",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0"
  },
  "build": {
    "appId": "no.haugemaskin.app",
    "productName": "Hauge Maskin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hauge Maskin"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thomashauge03",
        "repo": "hauge-maskin-app"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
